---
import { experiences } from "../data/portfolio";

const accentColors = ["var(--color-soft-purple)", "var(--color-soft-blue)", "var(--color-soft-green)", "var(--color-soft-yellow)"];

const experienceData = experiences.map((exp, idx) => ({
  role: exp.role,
  company: exp.company,
  period: exp.period,
  highlights: exp.highlights,
  accent: accentColors[idx % accentColors.length],
}));
---

<section id="experience" class="section-pad">
  <div class="container-page">
    <div class="max-w-2xl">
      <div class="eyebrow">Experience</div>
      <h2 class="mt-3 text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.12] tracking-[-0.02em]">
        Where I've shipped, led, and learned.
      </h2>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-14">
      <!-- Timeline -->
      <ol class="relative">
        <span aria-hidden="true" class="absolute left-[14px] top-2 bottom-2 w-px bg-[color:var(--color-border)]"></span>

        {experienceData.map((exp) => (
          <li class="relative pl-12 pb-10 last:pb-0">
            <span
              aria-hidden="true"
              class="absolute left-0 top-1.5 grid h-7 w-7 place-items-center rounded-full border border-[color:var(--color-border)] bg-white"
              style={`background: ${exp.accent};`}
            >
              <span class="h-2 w-2 rounded-full bg-[color:var(--color-ink)]"></span>
            </span>

            <div class="card-soft p-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="text-[18px] font-semibold tracking-tight text-[color:var(--color-ink)]">{exp.role}</h3>
                  <div class="mt-0.5 text-[13px] font-medium text-[color:var(--color-ink-3)]">{exp.company}</div>
                </div>
                <span class="rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-bg-soft)] px-2.5 py-1 text-[11.5px] font-semibold text-[color:var(--color-ink-2)]">
                  {exp.period}
                </span>
              </div>

              <ul class="mt-4 space-y-2">
                {exp.highlights.map((highlight) => (
                  <li class="flex gap-2 text-[14.5px] leading-[1.6] text-[color:var(--color-ink-2)]">
                    <span class="shrink-0 mt-1 text-[color:var(--color-accent)]">•</span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>

      <!-- Callout -->
      <aside class="lg:sticky lg:top-24 self-start">
        <div class="relative overflow-hidden rounded-[var(--radius-card-lg)] border border-[color:var(--color-border)] bg-[color:var(--color-soft-yellow)] p-7 sm:p-8">
          <div aria-hidden="true" class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white/50 blur-xl"></div>
          <svg aria-hidden="true" width="34" height="26" viewBox="0 0 34 26" class="text-[color:var(--color-ink)]/85">
            <path fill="currentColor" d="M0 26V14c0-7 4-12 12-14l2 4c-5 2-7 5-7 9h7v13H0Zm20 0V14c0-7 4-12 12-14l2 4c-5 2-7 5-7 9h7v13H20Z"/>
          </svg>
          <p class="mt-4 text-[18px] font-medium leading-[1.5] tracking-[-0.01em] text-[color:var(--color-ink)]">
            I enjoy connecting engineering with business problems and building systems that scale.
          </p>
          <div class="mt-6 flex items-center gap-3">
            <div class="grid h-9 w-9 place-items-center rounded-full bg-[color:var(--color-ink)] text-[12px] font-bold text-white">US</div>
            <div class="text-[13px]">
              <div class="font-semibold text-[color:var(--color-ink)]">Umar Syarif</div>
              <div class="text-[color:var(--color-ink-2)]">on the work I love</div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
