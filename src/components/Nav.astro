---
const links = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Achievements", href: "#achievements" },
  { label: "Contact", href: "#contact" },
];
---

<header class="sticky top-0 z-50 border-b border-[color:var(--color-border-soft)] bg-white/85 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <nav class="container-page flex h-16 items-center justify-between">
    <a href="#top" class="flex items-center gap-2.5 group">
      <span class="grid h-9 w-9 place-items-center rounded-[10px] bg-[color:var(--color-ink)] text-[13px] font-bold tracking-tight text-white shadow-sm transition-transform group-hover:scale-105">
        US
      </span>
      <span class="text-[15px] font-semibold tracking-tight">Umar Syarif</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="relative rounded-md px-3 py-2 text-[13.5px] font-medium text-[color:var(--color-ink-2)] transition hover:text-[color:var(--color-ink)]"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="#contact"
      class="hidden md:inline-flex items-center gap-1.5 rounded-lg bg-[color:var(--color-ink)] px-3.5 py-2 text-[13px] font-semibold text-white transition hover:bg-black"
    >
      Let's talk
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>

    <button
      type="button"
      class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[color:var(--color-border)] text-[color:var(--color-ink)]"
      aria-label="Open menu"
      data-mobile-toggle
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="17" x2="20" y2="17"/>
      </svg>
    </button>
  </nav>

  <div class="md:hidden hidden border-t border-[color:var(--color-border-soft)] bg-white" data-mobile-menu>
    <ul class="container-page flex flex-col py-3">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-md px-3 py-3 text-[15px] font-medium text-[color:var(--color-ink-2)] hover:bg-[color:var(--color-bg-soft)]"
            data-mobile-link
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const menu = document.querySelector<HTMLDivElement>("[data-mobile-menu]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  links.forEach((link) =>
    link.addEventListener("click", () => menu?.classList.add("hidden"))
  );
</script>
