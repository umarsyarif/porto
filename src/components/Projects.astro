---

<section id="projects" class="section-pad">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <div class="eyebrow">Featured Projects</div>
        <h2 class="mt-3 text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.12] tracking-[-0.02em]">
          Selected things I've been building.
        </h2>
        <p class="mt-4 text-[16px] leading-[1.7] text-[color:var(--color-ink-2)]">
          A mix of full-stack applications, AI-assisted workflows, and product experiments.
        </p>
      </div>
      <a href="#" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-[color:var(--color-ink)] hover:text-[color:var(--color-accent)] transition">
        View all projects
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <!-- Showcase frame -->
    <div
      class="mt-12 rounded-[28px] p-2.5 sm:p-3.5 transition-colors duration-500"
      data-showcase-frame
      style={`background: ${projects[0].frameTint};`}
    >
      <div class="rounded-[22px] bg-white p-6 sm:p-8 lg:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:gap-12">
          <!-- Left: project info -->
          <div class="flex flex-col">
            {projects.map((project, pIndex) => (
              <div data-info={project.id} class:list={["flex flex-col flex-1", pIndex !== 0 && "hidden"]}>
                <div class="flex items-center gap-2.5">
                  <div
                    class="grid h-11 w-11 place-items-center rounded-xl text-[color:var(--color-ink)]"
                    style={`background: ${project.iconTint};`}
                  >
                    <Icon name={project.icon} class="h-5 w-5" />
                  </div>
                  <div>
                    <div class="text-[11.5px] font-semibold uppercase tracking-[0.12em] text-[color:var(--color-ink-3)]">{project.tagline}</div>
                    <span
                      class="mt-0.5 inline-flex rounded-full px-2 py-0.5 text-[10.5px] font-semibold"
                      style={`background: ${project.statusTint}; color: ${project.statusColor};`}
                    >
                      {project.status}
                    </span>
                  </div>
                </div>

                <h3 class="mt-5 text-[clamp(1.5rem,2.4vw,2rem)] font-bold tracking-[-0.02em] text-[color:var(--color-ink)]">
                  {project.name}
                </h3>
                <p class="mt-3 text-[15px] leading-[1.7] text-[color:var(--color-ink-2)]">
                  {project.description}
                </p>

                <ul class="mt-6 space-y-1">
                  {project.features.map((feature, fIndex) => (
                    <li>
                      <button
                        type="button"
                        data-feature-item
                        data-project={project.id}
                        data-index={fIndex}
                        data-active={fIndex === 0 ? "" : undefined}
                        class="group flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition data-[active]:bg-[color:var(--color-bg-soft)] hover:bg-[color:var(--color-bg-soft)]"
                      >
                        <span
                          class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-[color:var(--color-border)] bg-white text-[10.5px] font-bold text-[color:var(--color-ink-3)] transition group-data-[active]:border-transparent group-data-[active]:text-white"
                          style={`--accent: ${project.accent};`}
                          data-feature-bullet
                        >
                          <span class="">{fIndex + 1}</span>
                        </span>
                        <span class="min-w-0">
                          <span class="block text-[14px] font-semibold text-[color:var(--color-ink)]">{feature.name}</span>
                          <span class="hidden text-[12.5px] leading-[1.55] text-[color:var(--color-ink-2)] line-clamp-2 group-data-[active]:block group-data-[active]:line-clamp-none">{feature.description}</span>
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>

                <div class="mt-7 flex flex-wrap items-center gap-4">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="GitHub repository"
                      class="grid h-9 w-9 place-items-center rounded-lg border border-[color:var(--color-border)] bg-white text-[color:var(--color-ink-2)] transition hover:border-[color:var(--color-ink)]/30 hover:text-[color:var(--color-ink)]"
                    >
                      <Icon name="lucide:github" class="h-4 w-4" />
                    </a>
                  )}
                  <ul class="flex flex-wrap gap-1.5">
                    {project.stack.map((tech) => (
                      <li class="rounded-md bg-[color:var(--color-bg-soft)] px-2 py-0.5 text-[11.5px] font-medium text-[color:var(--color-ink-2)]">
                        {tech}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>

          <!-- Right: feature carousel -->
          <div class="relative">
            <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-soft)]" data-mockup-stage>

              <!-- Finance / Wallet management -->
              <div data-mockup data-project="finance" data-index="0" class="absolute inset-0 transition-opacity duration-300">
                <img src="/screenshots/finance-wallets.svg" alt="Wallet management" class="h-full w-full object-cover object-top" />
              </div>

              <!-- Finance / Transactions -->
              <div data-mockup data-project="finance" data-index="1" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/finance-transactions.svg" alt="Transaction tracking" class="h-full w-full object-cover object-top" />
              </div>

              <!-- Finance / Dashboard -->
              <div data-mockup data-project="finance" data-index="2" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/finance-dashboard.svg" alt="Smart dashboards" class="h-full w-full object-cover object-top" />
              </div>

              <!-- Finance / PWA -->
              <div data-mockup data-project="finance" data-index="3" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/finance-pwa.svg" alt="Installable PWA" class="h-full w-full object-cover object-top" />
              </div>

              <!-- WhatsApp / Natural language -->
              <div data-mockup data-project="whatsapp" data-index="0" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/whatsapp-chat.svg" alt="Natural language parsing" class="h-full w-full object-cover object-top" />
              </div>

              <!-- WhatsApp / Structured ledger -->
              <div data-mockup data-project="whatsapp" data-index="1" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/whatsapp-ledger.svg" alt="Structured transactions" class="h-full w-full object-cover object-top" />
              </div>

              <!-- WhatsApp / Summary -->
              <div data-mockup data-project="whatsapp" data-index="2" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/whatsapp-summary.svg" alt="Weekly summaries" class="h-full w-full object-cover object-top" />
              </div>

              <!-- TOPIK / Test mode -->
              <div data-mockup data-project="topik" data-index="0" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/topik-test.svg" alt="Realistic test mode" class="h-full w-full object-cover object-top" />
              </div>

              <!-- TOPIK / Score analysis -->
              <div data-mockup data-project="topik" data-index="1" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/topik-scores.svg" alt="Score analysis" class="h-full w-full object-cover object-top" />
              </div>

              <!-- TOPIK / Packages -->
              <div data-mockup data-project="topik" data-index="2" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <img src="/screenshots/topik-packages.svg" alt="Question packages" class="h-full w-full object-cover object-top" />
              </div>
            </div>

            <!-- Prev / Next arrows -->
            <button
              type="button"
              data-prev
              class="absolute left-3 top-1/2 -translate-y-1/2 grid h-10 w-10 place-items-center rounded-full border border-[color:var(--color-border)] bg-white shadow-[0_8px_24px_-12px_rgba(17,24,39,0.18)] transition hover:bg-[color:var(--color-bg-soft)] hover:-translate-x-0.5"
              aria-label="Previous feature"
            >
              <Icon name="lucide:chevron-left" class="h-5 w-5"/>
            </button>
            <button
              type="button"
              data-next
              class="absolute right-3 top-1/2 -translate-y-1/2 grid h-10 w-10 place-items-center rounded-full border border-[color:var(--color-border)] bg-white shadow-[0_8px_24px_-12px_rgba(17,24,39,0.18)] transition hover:bg-[color:var(--color-bg-soft)] hover:translate-x-0.5"
              aria-label="Next feature"
            >
              <Icon name="lucide:chevron-right" class="h-5 w-5"/>
            </button>

            <!-- Dots -->
            <div class="mt-5 flex items-center justify-center gap-1.5">
              {projects.map((project) =>
                project.features.map((_, fIndex) => (
                  <span
                    data-dot
                    data-project={project.id}
                    data-index={fIndex}
                    data-active={project.id === projects[0].id && fIndex === 0 ? "" : undefined}
                    class:list={[
                      "h-1.5 rounded-full bg-[color:var(--color-border)] transition-all duration-300 data-[active]:bg-[color:var(--color-ink)] data-[active]:w-6",
                      project.id !== projects[0].id && "hidden",
                      "w-1.5",
                    ]}
                  ></span>
                ))
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- More work — horizontal scroll -->
    <div class="mt-16">
      <div class="flex items-center gap-4 mb-6">
        <div class="eyebrow">More work</div>
        <div class="flex-1 h-px bg-[color:var(--color-border)]"></div>
        <span class="text-[12px] text-[color:var(--color-ink-3)] hidden sm:block">scroll →</span>
      </div>
      <!-- Bleed the scroll track to the container edge -->
      <div class="-mx-5 md:-mx-8 lg:-mx-0">
        <div class="flex gap-4 overflow-x-auto scroll-smooth pb-4 px-5 md:px-8 lg:px-0 snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {moreProjects.map((proj) => (
            <div class="card-soft flex flex-col p-5 snap-start shrink-0 w-[290px] sm:w-[310px]">
              <div class="flex items-start justify-between gap-3">
                <div
                  class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-[color:var(--color-ink)]"
                  style={`background: ${proj.iconTint};`}
                >
                  <Icon name={proj.icon} class="h-5 w-5" />
                </div>
                <div class="flex gap-1.5">
                  {proj.github && (
                    <a
                      href={proj.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="GitHub"
                      class="grid h-8 w-8 place-items-center rounded-lg border border-[color:var(--color-border)] text-[color:var(--color-ink-3)] transition hover:text-[color:var(--color-ink)]"
                    >
                      <Icon name="lucide:github" class="h-3.5 w-3.5" />
                    </a>
                  )}
                  {proj.live && (
                    <a
                      href={proj.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Live site"
                      class="grid h-8 w-8 place-items-center rounded-lg border border-[color:var(--color-border)] text-[color:var(--color-ink-3)] transition hover:text-[color:var(--color-ink)]"
                    >
                      <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
                    </a>
                  )}
                </div>
              </div>

              <div class="mt-4 flex-1">
                <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[color:var(--color-ink-3)]">{proj.tagline} · {proj.year}</div>
                <h3 class="mt-1.5 text-[15px] font-semibold leading-snug tracking-tight text-[color:var(--color-ink)]">{proj.name}</h3>
                <p class="mt-2 text-[13px] leading-[1.6] text-[color:var(--color-ink-2)]">{proj.description}</p>
              </div>

              <ul class="mt-4 flex flex-wrap gap-1.5">
                {proj.stack.map((tech) => (
                  <li class="rounded-md bg-[color:var(--color-bg-soft)] px-2 py-0.5 text-[11px] font-medium text-[color:var(--color-ink-2)]">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom: other project cards -->
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      {projects.map((project) => (
        <button
          type="button"
          data-project-card={project.id}
          data-active={project.id === projects[0].id ? "" : undefined}
          class="group relative flex w-full max-w-[280px] items-center gap-3 rounded-2xl border border-[color:var(--color-border)] bg-white p-4 text-left transition data-[active]:hidden hover:-translate-y-0.5 hover:border-[color:var(--color-ink)]/30 hover:shadow-[0_10px_28px_-12px_rgba(17,24,39,0.12)]"
        >
          <div
            class="grid h-11 w-11 shrink-0 place-items-center rounded-xl text-[color:var(--color-ink)]"
            style={`background: ${project.iconTint};`}
          >
            <Icon name={project.icon} class="h-5 w-5"/>
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-[color:var(--color-ink-3)]">{project.tagline}</div>
            <div class="mt-0.5 truncate text-[14px] font-semibold text-[color:var(--color-ink)]">{project.name}</div>
          </div>
          <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-[color:var(--color-ink-3)] transition group-hover:text-[color:var(--color-ink)]"/>
        </button>
      ))}
    </div>
  </div>
</section>

<script is:inline define:vars={{ featureCountById, projectFrameTints: Object.fromEntries(projects.map(p => [p.id, p.frameTint])) }}>
  (() => {
    const counts = JSON.parse(featureCountById);
    const projectIds = Object.keys(counts);
    let activeProject = projectIds[0];
    let activeIndex = 0;

    const frame = document.querySelector("[data-showcase-frame]");
    const stage = document.querySelector("[data-mockup-stage]");

    function setActive(node, isActive) {
      if (isActive) node.setAttribute("data-active", "");
      else node.removeAttribute("data-active");
    }

    function render() {
      // Frame tint
      if (frame) frame.style.background = projectFrameTints[activeProject];

      // Info panels
      document.querySelectorAll("[data-info]").forEach((el) => {
        el.classList.toggle("hidden", el.dataset.info !== activeProject);
      });

      // Feature list buttons (only show items belonging to active project; mark active)
      document.querySelectorAll("[data-feature-item]").forEach((el) => {
        const isThisProject = el.dataset.project === activeProject;
        const isActive = isThisProject && Number(el.dataset.index) === activeIndex;
        setActive(el, isActive);
      });

      // Mockups
      document.querySelectorAll("[data-mockup]").forEach((el) => {
        const isActive = el.dataset.project === activeProject && Number(el.dataset.index) === activeIndex;
        el.classList.toggle("opacity-0", !isActive);
        el.classList.toggle("pointer-events-none", !isActive);
      });

      // Dots
      document.querySelectorAll("[data-dot]").forEach((el) => {
        const belongs = el.dataset.project === activeProject;
        el.classList.toggle("hidden", !belongs);
        const isActive = belongs && Number(el.dataset.index) === activeIndex;
        setActive(el, isActive);
      });

      // Project cards
      document.querySelectorAll("[data-project-card]").forEach((el) => {
        setActive(el, el.dataset.projectCard === activeProject);
      });
    }

    document.querySelectorAll("[data-project-card]").forEach((el) => {
      el.addEventListener("click", () => {
        activeProject = el.dataset.projectCard;
        activeIndex = 0;
        render();
      });
    });

    document.querySelectorAll("[data-feature-item]").forEach((el) => {
      el.addEventListener("click", () => {
        activeProject = el.dataset.project;
        activeIndex = Number(el.dataset.index);
        render();
      });
    });

    document.querySelector("[data-prev]")?.addEventListener("click", () => {
      const total = counts[activeProject];
      activeIndex = (activeIndex - 1 + total) % total;
      render();
    });
    document.querySelector("[data-next]")?.addEventListener("click", () => {
      const total = counts[activeProject];
      activeIndex = (activeIndex + 1) % total;
      render();
    });

    // Keyboard arrows when stage is focused/hovered
    document.addEventListener("keydown", (e) => {
      if (!stage) return;
      const rect = stage.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (!inView) return;
      if (e.key === "ArrowLeft") document.querySelector("[data-prev]")?.click();
      if (e.key === "ArrowRight") document.querySelector("[data-next]")?.click();
    });

    render();
  })();
</script>
