---
import { Icon } from "astro-icon/components";

type Feature = { name: string; description: string };
type Project = {
  id: string;
  name: string;
  tagline: string;
  description: string;
  status: string;
  statusTint: string;
  statusColor: string;
  icon: string;
  iconTint: string;
  frameTint: string;
  accent: string;
  stack: string[];
  features: Feature[];
};

const projects: Project[] = [
  {
    id: "finance",
    name: "Personal Finance Tracker",
    tagline: "Self-hosted · PWA",
    description:
      "A self-hosted finance tracker with wallet management, transaction tracking, dashboards, and PWA support.",
    status: "In Development",
    statusTint: "var(--color-soft-yellow)",
    statusColor: "#9a6a00",
    icon: "lucide:wallet",
    iconTint: "var(--color-soft-purple)",
    frameTint: "#e8e3ff",
    accent: "#6d5df6",
    stack: ["React", "Node.js", "PostgreSQL", "Docker"],
    features: [
      { name: "Wallet management", description: "Track every account, cash stash, and savings goal in one place." },
      { name: "Transaction tracking", description: "Add, tag, and filter every income and expense with category rules." },
      { name: "Smart dashboards", description: "Visualize cashflow, spending categories, and net worth at a glance." },
      { name: "Installable PWA", description: "Mobile-friendly, installable, works offline. No app store needed." },
    ],
  },
  {
    id: "whatsapp",
    name: "WhatsApp Financial AI Assistant",
    tagline: "AI workflow · n8n",
    description:
      "An AI assistant that parses natural language finance messages into structured transactions and summaries.",
    status: "Prototype",
    statusTint: "var(--color-soft-blue)",
    statusColor: "#1d4ed8",
    icon: "lucide:message-square-text",
    iconTint: "var(--color-soft-green)",
    frameTint: "#dff4e6",
    accent: "#16a34a",
    stack: ["n8n", "OpenAI", "Google Sheets", "WhatsApp API"],
    features: [
      { name: "Natural language parsing", description: "Type how you talk. The AI figures out the amount, category, and date." },
      { name: "Structured transactions", description: "Each message is logged as a clean row in your Sheets ledger." },
      { name: "Weekly summaries", description: "Get an automatic recap of spending, income, and top categories." },
    ],
  },
  {
    id: "topik",
    name: "TOPIK Test Simulation",
    tagline: "EdTech · Korean learning",
    description:
      "A Korean test simulation platform with paid question packages, score analysis, and learning-focused review.",
    status: "Product Concept",
    statusTint: "var(--color-soft-orange)",
    statusColor: "#a14a00",
    icon: "lucide:graduation-cap",
    iconTint: "var(--color-soft-orange)",
    frameTint: "#ffe7d1",
    accent: "#d97706",
    stack: ["React", "Tailwind CSS", "EdTech", "TBD"],
    features: [
      { name: "Realistic test mode", description: "Mirrors the actual TOPIK exam: timing, layout, and section flow." },
      { name: "Score analysis", description: "Breaks down strengths and weaknesses by section and topic." },
      { name: "Question packages", description: "Buy focused practice packs by topic, level, or full mock tests." },
    ],
  },
];

const featureCountById = JSON.stringify(
  Object.fromEntries(projects.map((p) => [p.id, p.features.length]))
);
---

<section id="projects" class="section-pad">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <div class="eyebrow">Featured Projects</div>
        <h2 class="mt-3 text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.12] tracking-[-0.02em]">
          Selected things I've been building.
        </h2>
        <p class="mt-4 text-[16px] leading-[1.7] text-[color:var(--color-ink-2)]">
          A mix of full-stack applications, AI-assisted workflows, and product experiments.
        </p>
      </div>
      <a href="#" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-[color:var(--color-ink)] hover:text-[color:var(--color-accent)] transition">
        View all projects
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <!-- Showcase frame -->
    <div
      class="mt-12 rounded-[28px] p-2.5 sm:p-3.5 transition-colors duration-500"
      data-showcase-frame
      style={`background: ${projects[0].frameTint};`}
    >
      <div class="rounded-[22px] bg-white p-6 sm:p-8 lg:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:gap-12">
          <!-- Left: project info -->
          <div class="flex flex-col">
            {projects.map((project, pIndex) => (
              <div data-info={project.id} class:list={["flex flex-col flex-1", pIndex !== 0 && "hidden"]}>
                <div class="flex items-center gap-2.5">
                  <div
                    class="grid h-11 w-11 place-items-center rounded-xl text-[color:var(--color-ink)]"
                    style={`background: ${project.iconTint};`}
                  >
                    <Icon name={project.icon} class="h-5 w-5" />
                  </div>
                  <div>
                    <div class="text-[11.5px] font-semibold uppercase tracking-[0.12em] text-[color:var(--color-ink-3)]">{project.tagline}</div>
                    <span
                      class="mt-0.5 inline-flex rounded-full px-2 py-0.5 text-[10.5px] font-semibold"
                      style={`background: ${project.statusTint}; color: ${project.statusColor};`}
                    >
                      {project.status}
                    </span>
                  </div>
                </div>

                <h3 class="mt-5 text-[clamp(1.5rem,2.4vw,2rem)] font-bold tracking-[-0.02em] text-[color:var(--color-ink)]">
                  {project.name}
                </h3>
                <p class="mt-3 text-[15px] leading-[1.7] text-[color:var(--color-ink-2)]">
                  {project.description}
                </p>

                <ul class="mt-6 space-y-1">
                  {project.features.map((feature, fIndex) => (
                    <li>
                      <button
                        type="button"
                        data-feature-item
                        data-project={project.id}
                        data-index={fIndex}
                        data-active={fIndex === 0 ? "" : undefined}
                        class="group flex w-full items-start gap-3 rounded-xl px-3 py-2.5 text-left transition data-[active]:bg-[color:var(--color-bg-soft)] hover:bg-[color:var(--color-bg-soft)]"
                      >
                        <span
                          class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-[color:var(--color-border)] bg-white text-[10.5px] font-bold text-[color:var(--color-ink-3)] transition group-data-[active]:border-transparent group-data-[active]:text-white"
                          style={`--accent: ${project.accent};`}
                          data-feature-bullet
                        >
                          <span class="group-data-[active]:hidden">{fIndex + 1}</span>
                          <span class="hidden h-2 w-2 rounded-full bg-white group-data-[active]:block"></span>
                        </span>
                        <span class="min-w-0">
                          <span class="block text-[14px] font-semibold text-[color:var(--color-ink)]">{feature.name}</span>
                          <span class="block text-[12.5px] leading-[1.55] text-[color:var(--color-ink-2)] line-clamp-2 group-data-[active]:line-clamp-none">{feature.description}</span>
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>

                <div class="mt-7 flex flex-wrap items-center gap-4">
                  <a
                    href="#"
                    class="inline-flex items-center gap-1.5 rounded-lg bg-[color:var(--color-ink)] px-4 py-2.5 text-[13px] font-semibold text-white transition hover:bg-black"
                  >
                    View case study
                    <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
                  </a>
                  <ul class="flex flex-wrap gap-1.5">
                    {project.stack.map((tech) => (
                      <li class="rounded-md bg-[color:var(--color-bg-soft)] px-2 py-0.5 text-[11.5px] font-medium text-[color:var(--color-ink-2)]">
                        {tech}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>

          <!-- Right: feature carousel -->
          <div class="relative">
            <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-soft)]" data-mockup-stage>

              <!-- Finance / Wallet management -->
              <div data-mockup data-project="finance" data-index="0" class="absolute inset-0 transition-opacity duration-300">
                <div class="relative h-full overflow-hidden">
                  <div class="absolute inset-0" style="background: linear-gradient(140deg, #faf8ff 0%, #ffffff 60%);"></div>
                  <div class="relative h-full p-5 sm:p-7">
                    <div class="flex items-center justify-between">
                      <div>
                        <div class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[color:var(--color-ink-3)]">Wallets</div>
                        <div class="mt-1 text-[20px] font-bold tracking-[-0.02em] text-[color:var(--color-ink)]">Total · $7,170</div>
                      </div>
                      <button class="inline-flex items-center gap-1 rounded-lg bg-[color:var(--color-ink)] px-2.5 py-1.5 text-[11px] font-semibold text-white">
                        <Icon name="lucide:plus" class="h-3 w-3" /> New
                      </button>
                    </div>

                    <ul class="mt-5 space-y-2.5">
                      <li class="flex items-center justify-between rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="flex items-center gap-3">
                          <span class="grid h-9 w-9 place-items-center rounded-lg bg-[color:var(--color-soft-blue)] text-[color:var(--color-ink)]"><Icon name="lucide:landmark" class="h-4 w-4"/></span>
                          <div>
                            <div class="text-[13px] font-semibold">Main Bank</div>
                            <div class="text-[11px] text-[color:var(--color-ink-3)]">Bank · IDR</div>
                          </div>
                        </div>
                        <div class="text-right">
                          <div class="text-[13px] font-bold">$4,250.00</div>
                          <div class="text-[10.5px] text-[color:var(--color-success)]">+ $120 this week</div>
                        </div>
                      </li>
                      <li class="flex items-center justify-between rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="flex items-center gap-3">
                          <span class="grid h-9 w-9 place-items-center rounded-lg bg-[color:var(--color-soft-green)] text-[color:var(--color-ink)]"><Icon name="lucide:piggy-bank" class="h-4 w-4"/></span>
                          <div>
                            <div class="text-[13px] font-semibold">Savings</div>
                            <div class="text-[11px] text-[color:var(--color-ink-3)]">Goal · House</div>
                          </div>
                        </div>
                        <div class="text-right">
                          <div class="text-[13px] font-bold">$2,800.00</div>
                          <div class="text-[10.5px] text-[color:var(--color-ink-3)]">56% of goal</div>
                        </div>
                      </li>
                      <li class="flex items-center justify-between rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="flex items-center gap-3">
                          <span class="grid h-9 w-9 place-items-center rounded-lg bg-[color:var(--color-soft-yellow)] text-[color:var(--color-ink)]"><Icon name="lucide:wallet" class="h-4 w-4"/></span>
                          <div>
                            <div class="text-[13px] font-semibold">Cash</div>
                            <div class="text-[11px] text-[color:var(--color-ink-3)]">Daily wallet</div>
                          </div>
                        </div>
                        <div class="text-right">
                          <div class="text-[13px] font-bold">$120.00</div>
                          <div class="text-[10.5px] text-[color:var(--color-ink-3)]">3 transactions</div>
                        </div>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Finance / Transactions -->
              <div data-mockup data-project="finance" data-index="1" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <div class="relative h-full overflow-hidden">
                  <div class="absolute inset-0" style="background: linear-gradient(140deg, #fafafa 0%, #ffffff 60%);"></div>
                  <div class="relative h-full p-5 sm:p-7">
                    <div class="flex items-center justify-between">
                      <div class="text-[15px] font-bold tracking-[-0.01em]">Transactions</div>
                      <div class="flex gap-1">
                        <span class="rounded-md bg-[color:var(--color-ink)] px-2 py-1 text-[10.5px] font-semibold text-white">All</span>
                        <span class="rounded-md border border-[color:var(--color-border)] bg-white px-2 py-1 text-[10.5px] font-medium text-[color:var(--color-ink-2)]">Income</span>
                        <span class="rounded-md border border-[color:var(--color-border)] bg-white px-2 py-1 text-[10.5px] font-medium text-[color:var(--color-ink-2)]">Expense</span>
                      </div>
                    </div>
                    <ul class="mt-4 divide-y divide-[color:var(--color-border-soft)] rounded-xl border border-[color:var(--color-border)] bg-white">
                      <li class="flex items-center justify-between gap-3 p-3">
                        <div class="flex items-center gap-3">
                          <span class="grid h-8 w-8 place-items-center rounded-lg bg-[color:var(--color-soft-orange)]"><Icon name="lucide:utensils" class="h-4 w-4"/></span>
                          <div>
                            <div class="text-[13px] font-semibold">Lunch · Padang Sederhana</div>
                            <div class="text-[10.5px] text-[color:var(--color-ink-3)]">Today · Food</div>
                          </div>
                        </div>
                        <div class="text-[13px] font-bold text-[color:var(--color-ink)]">−$3.20</div>
                      </li>
                      <li class="flex items-center justify-between gap-3 p-3">
                        <div class="flex items-center gap-3">
                          <span class="grid h-8 w-8 place-items-center rounded-lg bg-[color:var(--color-soft-green)]"><Icon name="lucide:arrow-down-to-line" class="h-4 w-4 text-[color:var(--color-success)]"/></span>
                          <div>
                            <div class="text-[13px] font-semibold">Freelance payment</div>
                            <div class="text-[10.5px] text-[color:var(--color-ink-3)]">Yesterday · Income</div>
                          </div>
                        </div>
                        <div class="text-[13px] font-bold text-[color:var(--color-success)]">+$420.00</div>
                      </li>
                      <li class="flex items-center justify-between gap-3 p-3">
                        <div class="flex items-center gap-3">
                          <span class="grid h-8 w-8 place-items-center rounded-lg bg-[color:var(--color-soft-blue)]"><Icon name="lucide:bus" class="h-4 w-4"/></span>
                          <div>
                            <div class="text-[13px] font-semibold">Subway pass · Seoul</div>
                            <div class="text-[10.5px] text-[color:var(--color-ink-3)]">Mon · Transport</div>
                          </div>
                        </div>
                        <div class="text-[13px] font-bold text-[color:var(--color-ink)]">−$48.00</div>
                      </li>
                      <li class="flex items-center justify-between gap-3 p-3">
                        <div class="flex items-center gap-3">
                          <span class="grid h-8 w-8 place-items-center rounded-lg bg-[color:var(--color-soft-purple)]"><Icon name="lucide:shopping-bag" class="h-4 w-4"/></span>
                          <div>
                            <div class="text-[13px] font-semibold">Groceries</div>
                            <div class="text-[10.5px] text-[color:var(--color-ink-3)]">Sun · Home</div>
                          </div>
                        </div>
                        <div class="text-[13px] font-bold text-[color:var(--color-ink)]">−$62.30</div>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Finance / Dashboard -->
              <div data-mockup data-project="finance" data-index="2" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <div class="relative h-full overflow-hidden">
                  <div class="absolute inset-0" style="background: linear-gradient(140deg, #eef2ff 0%, #ffffff 60%);"></div>
                  <div class="relative h-full p-5 sm:p-7">
                    <div class="grid grid-cols-3 gap-2.5">
                      <div class="rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--color-ink-3)]">Income</div>
                        <div class="mt-1 text-[15px] font-bold">$3,420</div>
                        <div class="mt-0.5 text-[10px] text-[color:var(--color-success)]">▲ 12%</div>
                      </div>
                      <div class="rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--color-ink-3)]">Expense</div>
                        <div class="mt-1 text-[15px] font-bold">$1,840</div>
                        <div class="mt-0.5 text-[10px] text-[color:var(--color-ink-3)]">▼ 4%</div>
                      </div>
                      <div class="rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-[color:var(--color-ink-3)]">Net</div>
                        <div class="mt-1 text-[15px] font-bold">$1,580</div>
                        <div class="mt-0.5 text-[10px] text-[color:var(--color-success)]">on track</div>
                      </div>
                    </div>

                    <div class="mt-4 rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                      <div class="flex items-center justify-between">
                        <div class="text-[12px] font-semibold">Spending — last 7 weeks</div>
                        <div class="text-[10.5px] text-[color:var(--color-ink-3)]">USD</div>
                      </div>
                      <svg viewBox="0 0 280 90" class="mt-2 h-24 w-full" preserveAspectRatio="none">
                        <defs>
                          <linearGradient id="barGrad" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0" stop-color="#6d5df6"/>
                            <stop offset="1" stop-color="#a99dff"/>
                          </linearGradient>
                        </defs>
                        {[42, 58, 36, 70, 50, 78, 62].map((h, i) => (
                          <g>
                            <rect x={10 + i * 38} y={88 - h} width="22" height={h} rx="4" fill="url(#barGrad)"/>
                          </g>
                        ))}
                      </svg>
                      <div class="mt-1 flex justify-between text-[9.5px] text-[color:var(--color-ink-3)]">
                        <span>W1</span><span>W2</span><span>W3</span><span>W4</span><span>W5</span><span>W6</span><span>W7</span>
                      </div>
                    </div>

                    <div class="mt-3 grid grid-cols-2 gap-2.5">
                      <div class="rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="text-[10.5px] font-semibold text-[color:var(--color-ink-3)]">Top category</div>
                        <div class="mt-1 flex items-center gap-2">
                          <span class="h-2 w-2 rounded-full bg-[#6d5df6]"></span>
                          <span class="text-[12px] font-semibold">Food</span>
                        </div>
                        <div class="text-[10.5px] text-[color:var(--color-ink-3)]">42% · $772</div>
                      </div>
                      <div class="rounded-xl border border-[color:var(--color-border)] bg-white p-3">
                        <div class="text-[10.5px] font-semibold text-[color:var(--color-ink-3)]">Savings rate</div>
                        <div class="mt-1 text-[14px] font-bold">46%</div>
                        <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-[color:var(--color-bg-soft)]">
                          <div class="h-full rounded-full bg-[color:var(--color-success)]" style="width:46%"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Finance / PWA -->
              <div data-mockup data-project="finance" data-index="3" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
                <div class="relative h-full overflow-hidden">
                  <div class="absolute inset-0" style="background: linear-gradient(140deg, #f1eeff 0%, #ffffff 60%);"></div>
                  <div class="relative grid h-full place-items-center p-5">
                    <div class="relative">
                      <!-- Phone frame -->
                      <div class="relative h-[280px] w-[150px] rounded-[28px] border-[5px] border-[color:var(--color-ink)] bg-white shadow-[0_30px_60px_-30px_rgba(17,24,39,0.4)]">
                        <div class="absolute left-1/2 top-1.5 h-1 w-12 -translate-x-1/2 rounded-full bg-[color:var(--color-ink)]"></div>
                        <div class="absolute inset-1.5 mt-5 grid grid-rows-[auto_auto_1fr_auto] gap-2 overflow-hidden rounded-[20px] bg-[color:var(--color-bg-soft)] p-2.5">
                          <div class="flex items-center justify-between text-[8px] font-semibold text-[color:var(--color-ink-3)]">
                            <span>9:41</span><span>●●●</span>
                          </div>
                          <div>
                            <div class="text-[10px] font-bold leading-tight">Finance</div>
                            <div class="text-[8px] text-[color:var(--color-ink-3)]">Good evening, Umar</div>
                          </div>
                          <div class="grid grid-cols-2 gap-1.5 content-start">
                            <div class="rounded-md bg-white p-1.5"><div class="text-[7.5px] text-[color:var(--color-ink-3)]">Net</div><div class="text-[10px] font-bold">$1.58k</div></div>
                            <div class="rounded-md bg-white p-1.5"><div class="text-[7.5px] text-[color:var(--color-ink-3)]">Goal</div><div class="text-[10px] font-bold">56%</div></div>
                            <div class="col-span-2 rounded-md bg-white p-1.5">
                              <div class="text-[7.5px] text-[color:var(--color-ink-3)]">Latest</div>
                              <div class="mt-0.5 flex items-center justify-between"><span class="text-[8px] font-medium">Lunch</span><span class="text-[8px] font-bold">−$3.20</span></div>
                              <div class="mt-0.5 flex items-center justify-between"><span class="text-[8px] font-medium">Subway</span><span class="text-[8px] font-bold">−$48</span></div>
                            </div>
                          </div>
                          <button class="rounded-md bg-[color:var(--color-ink)] py-1 text-[8.5px] font-semibold text-white">+ Add transaction</button>
                        </div>
                      </div>
                      <!-- Install card -->
                      <div class="absolute -right-12 top-4 w-44 rotate-[6deg] rounded-xl border border-[color:var(--color-border)] bg-white p-3 shadow-[0_20px_40px_-20px_rgba(17,24,39,0.25)]">
                        <div class="flex items-center gap-2">
                          <span class="grid h-7 w-7 place-items-center rounded-md bg-[color:var(--color-ink)] text-[9px] font-bold text-white">FT</span>
                          <div class="text-[10.5px] font-semibold leading-tight">Install Finance<br/>Tracker?</div>
                        </div>
                        <div class="mt-2 flex gap-1.5">
                          <button class="flex-1 rounded-md bg-[color:var(--color-ink)] py-1 text-[9.5px] font-semibold text-white">Install</button>
                          <button class="rounded-md border border-[color:var(--color-border)] px-2 py-1 text-[9.5px] font-semibold text-[color:var(--color-ink-2)]">Later</button>
                        </div>
                      </div>
                      <!-- Offline badge -->
                      <div class="absolute -left-10 bottom-12 rotate-[-8deg] rounded-full border border-[color:var(--color-border)] bg-white px-2.5 py-1 text-[10px] font-semibold text-[color:var(--color-ink-2)] shadow-sm">
                        <Icon name="lucide:wifi-off" class="mr-1 inline h-3 w-3"/> Works offline
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- WhatsApp / Natural language -->
              <div data-mockup data-project="whatsapp" data-index="0" class="absolute inset-0 transition-opacity duration-300 opacity-0 pointer-events-none">
