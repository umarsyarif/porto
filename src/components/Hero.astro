---
import { Icon } from "astro-icon/components";
import { aboutMe } from "../data/portfolio";

const tags = aboutMe.tagline.split(" · ");
---

<section id="top" class="relative overflow-hidden">
  <div
    class="container-page relative pt-14 pb-20 md:pt-20 md:pb-28 lg:pt-24 lg:pb-32"
  >
    <div
      class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
    >
      <!-- Left column -->
      <div class="relative">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-white px-3.5 py-1.5 text-[12.5px] font-semibold text-[color:var(--color-ink-2)] shadow-[0_1px_0_rgba(17,24,39,0.03)]"
        >
          <span class="relative grid h-2 w-2 place-items-center">
            <span
              class="absolute inset-0 rounded-full bg-[color:var(--color-accent)] opacity-30 pulse-dot"
            ></span>
            <span
              class="relative h-2 w-2 rounded-full bg-[color:var(--color-accent)]"
            ></span>
          </span>
          Product-minded Software Engineer
        </div>

        <h1
          class="mt-6 text-[clamp(2.25rem,4.3vw,3.75rem)] font-extrabold leading-[1.05] tracking-[-0.03em] text-[color:var(--color-ink)]"
        >
          Hi, I am Umar!
        </h1>

        <p
          class="mt-6 max-w-[58ch] text-[17px] leading-[1.7] text-[color:var(--color-ink-2)]"
        >
          I turn ideas and messy workflows into clean, scalable software, from
          full-stack applications and internal tools to AI-assisted automation
          systems.
        </p>

        <ul class="mt-7 flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <li class="rounded-full border border-[color:var(--color-border)] bg-white px-3 py-1.5 text-[12.5px] font-medium text-[color:var(--color-ink-2)]">
                {tag}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--color-ink)] px-5 py-3 text-[14px] font-semibold text-white transition hover:bg-black"
          >
            View My Work
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--color-border)] bg-white px-5 py-3 text-[14px] font-semibold text-[color:var(--color-ink)] transition hover:border-[color:var(--color-ink)]/30 hover:bg-[color:var(--color-bg-soft)]"
          >
            <Icon name="lucide:download" class="h-4 w-4" />
            Download CV
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-xl px-3 py-3 text-[14px] font-semibold text-[color:var(--color-ink-2)] transition hover:text-[color:var(--color-ink)]"
          >
            <Icon name="lucide:mail" class="h-4 w-4" />
            Contact Me
          </a>
        </div>

        <div
          class="mt-7 flex items-center gap-2.5 text-[13.5px] text-[color:var(--color-ink-2)]"
        >
          <span class="relative inline-flex h-2.5 w-2.5">
            <span
              class="absolute inset-0 animate-ping rounded-full bg-[color:var(--color-success)] opacity-40"
            ></span>
            <span
              class="relative h-2.5 w-2.5 rounded-full bg-[color:var(--color-success)]"
            ></span>
          </span>
          <span
            >Available for full-stack, automation, and product engineering
            opportunities</span
          >
        </div>
      </div>

      <!-- Right column: photo -->
      <div class="relative mx-auto w-full max-w-[480px] lg:max-w-none">
        <img
          src="/hero-image.png"
          alt="Umar Syarif"
          class="relative w-full h-auto drop-shadow-sm"
        />
      </div>
    </div>
  </div>
</section>
