---
import { Icon } from "astro-icon/components";
import { aboutMe } from "../data/portfolio";

const tags = aboutMe.tagline.split(" · ");
---

<section id="top" class="relative overflow-hidden">
  <div class="container-page relative pt-14 pb-20 md:pt-20 md:pb-28 lg:pt-24 lg:pb-32">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <!-- Left column -->
      <div class="relative">
        <div class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-white px-3.5 py-1.5 text-[12.5px] font-semibold text-[color:var(--color-ink-2)] shadow-[0_1px_0_rgba(17,24,39,0.03)]">
          <span class="relative grid h-2 w-2 place-items-center">
            <span class="absolute inset-0 rounded-full bg-[color:var(--color-accent)] opacity-30 pulse-dot"></span>
            <span class="relative h-2 w-2 rounded-full bg-[color:var(--color-accent)]"></span>
          </span>
          Product-minded Software Engineer
        </div>

        <h1 class="mt-6 text-[clamp(2.25rem,4.3vw,3.75rem)] font-extrabold leading-[1.05] tracking-[-0.03em] text-[color:var(--color-ink)]">
          Building web apps, automation systems, and AI-powered tools.
        </h1>

        <p class="mt-6 max-w-[58ch] text-[17px] leading-[1.7] text-[color:var(--color-ink-2)]">
          I turn ideas and messy workflows into clean, scalable software, from full-stack applications and internal tools to AI-assisted automation systems.
        </p>

        <ul class="mt-7 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-[color:var(--color-border)] bg-white px-3 py-1.5 text-[12.5px] font-medium text-[color:var(--color-ink-2)]">
              {tag}
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--color-ink)] px-5 py-3 text-[14px] font-semibold text-white transition hover:bg-black"
          >
            View My Work
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
          <a
            href="#"
            class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--color-border)] bg-white px-5 py-3 text-[14px] font-semibold text-[color:var(--color-ink)] transition hover:border-[color:var(--color-ink)]/30 hover:bg-[color:var(--color-bg-soft)]"
          >
            <Icon name="lucide:download" class="h-4 w-4" />
            Download CV
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-xl px-3 py-3 text-[14px] font-semibold text-[color:var(--color-ink-2)] transition hover:text-[color:var(--color-ink)]"
          >
            <Icon name="lucide:mail" class="h-4 w-4" />
            Contact Me
          </a>
        </div>

        <div class="mt-7 flex items-center gap-2.5 text-[13.5px] text-[color:var(--color-ink-2)]">
          <span class="relative inline-flex h-2.5 w-2.5">
            <span class="absolute inset-0 animate-ping rounded-full bg-[color:var(--color-success)] opacity-40"></span>
            <span class="relative h-2.5 w-2.5 rounded-full bg-[color:var(--color-success)]"></span>
          </span>
          <span>Available for full-stack, automation, and product engineering opportunities</span>
        </div>
      </div>

      <!-- Right column: illustration -->
      <div class="relative mx-auto w-full max-w-[480px] lg:max-w-none">
        <!-- Pastel blob backdrop -->
        <div aria-hidden="true" class="absolute -inset-6 -z-10 rounded-[40%_60%_55%_45%/55%_45%_60%_40%] bg-gradient-to-br from-[color:var(--color-soft-purple)] via-[color:var(--color-soft-blue)] to-[color:var(--color-soft-yellow)] blur-[2px] opacity-90"></div>
        <div aria-hidden="true" class="absolute -inset-2 -z-10 rounded-[60%_40%_45%_55%/40%_60%_45%_55%] bg-[color:var(--color-soft-purple)] opacity-60"></div>

        <div class="relative aspect-square">
          <!-- Center character card -->
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 grid h-[58%] w-[58%] place-items-center rounded-[28px] border border-[color:var(--color-border)] bg-white shadow-[0_24px_60px_-24px_rgba(109,93,246,0.35)]">
            <div class="text-[clamp(5rem,12vw,9rem)] leading-none">🧑‍💻</div>
            <!-- Mini code window inside card -->
            <div class="absolute bottom-5 left-5 right-5 rounded-xl border border-[color:var(--color-border-soft)] bg-[color:var(--color-bg-soft)] p-3 text-left font-mono text-[10.5px] leading-[1.55] text-[color:var(--color-ink-2)]">
              <div class="mb-1.5 flex gap-1">
                <span class="h-2 w-2 rounded-full bg-[#FF5F57]"></span>
                <span class="h-2 w-2 rounded-full bg-[#FEBC2E]"></span>
                <span class="h-2 w-2 rounded-full bg-[#28C840]"></span>
              </div>
              <div><span class="text-[color:var(--color-accent)]">const</span> <span class="text-[color:var(--color-ink)]">umar</span> = build(<span class="text-[#16a34a]">"ideas"</span>);</div>
            </div>
          </div>

          <!-- Floating doodle accents -->
          <div class="float-a absolute left-2 top-4 grid h-14 w-14 place-items-center rounded-2xl bg-[color:var(--color-soft-yellow)] text-[color:var(--color-ink)] shadow-sm">
            <Icon name="lucide:lightbulb" class="h-6 w-6" />
          </div>

          <div class="float-b absolute right-3 top-12 grid h-12 w-12 place-items-center rounded-2xl bg-[color:var(--color-soft-blue)] text-[color:var(--color-ink)] shadow-sm">
            <Icon name="lucide:braces" class="h-5 w-5" />
          </div>

          <div class="float-a absolute right-0 bottom-16 grid h-14 w-14 place-items-center rounded-2xl bg-[color:var(--color-soft-green)] text-[color:var(--color-ink)] shadow-sm">
            <Icon name="lucide:sprout" class="h-6 w-6" />
          </div>

          <div class="float-b absolute left-4 bottom-6 grid h-12 w-12 place-items-center rounded-2xl bg-[color:var(--color-soft-orange)] text-[color:var(--color-ink)] shadow-sm">
            <Icon name="lucide:coffee" class="h-5 w-5" />
          </div>

          <div class="float-a absolute left-1/2 -top-2 -translate-x-[160%] grid h-10 w-10 place-items-center rounded-2xl bg-white border border-[color:var(--color-border)] text-[color:var(--color-accent)] shadow-sm">
            <Icon name="lucide:sparkles" class="h-4 w-4" />
          </div>

          <!-- Sticky note -->
          <div class="float-b absolute right-2 bottom-2 rotate-[6deg] rounded-lg bg-[color:var(--color-soft-yellow)] px-3 py-2 shadow-[0_10px_20px_-12px_rgba(0,0,0,0.18)]">
            <div class="hand text-[18px] leading-tight text-[color:var(--color-ink)]">ship it ✺</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
