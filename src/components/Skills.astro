---
import { Icon } from "astro-icon/components";

const skills = [
  {
    title: "Frontend",
    icon: "lucide:layout-panel-top",
    tint: "var(--color-soft-purple)",
    tools: ["React", "Vue.js", "Vite", "Tailwind CSS", "shadcn/ui", "PWA", "Recharts"],
  },
  {
    title: "Backend",
    icon: "lucide:server",
    tint: "var(--color-soft-blue)",
    tools: ["Laravel", "Node.js", "Express", "REST API", "JWT Auth", "Prisma ORM"],
  },
  {
    title: "Automation & AI",
    icon: "lucide:bot",
    tint: "var(--color-soft-green)",
    tools: ["n8n", "OpenAI API", "WhatsApp API", "Telegram Bot", "Google Drive API"],
  },
  {
    title: "Database",
    icon: "lucide:database",
    tint: "var(--color-soft-yellow)",
    tools: ["PostgreSQL", "MySQL", "Google Sheets", "Prisma"],
  },
  {
    title: "Infrastructure",
    icon: "lucide:cloud",
    tint: "var(--color-soft-orange)",
    tools: ["Docker", "Docker Compose", "Traefik", "Ubuntu VPS", "Cloudflare", "Let's Encrypt"],
  },
  {
    title: "Testing",
    icon: "lucide:circle-check-big",
    tint: "var(--color-soft-red)",
    tools: ["Playwright", "SpecFlow", "UI Regression Testing", "Automated Testing"],
  },
];
---

<section id="skills" class="section-pad bg-[color:var(--color-bg-tint)]">
  <div class="container-page">
    <div class="max-w-2xl">
      <div class="eyebrow">Skills</div>
      <h2 class="mt-3 text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.12] tracking-[-0.02em]">
        A practical, full-stack toolkit.
      </h2>
      <p class="mt-4 text-[16px] leading-[1.7] text-[color:var(--color-ink-2)]">
        The tools I reach for to ship reliable web apps, automated workflows, and AI-assisted systems.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((skill) => (
        <div class="card-interactive p-6">
          <div
            class="grid h-12 w-12 place-items-center rounded-xl text-[color:var(--color-ink)]"
            style={`background: ${skill.tint};`}
          >
            <Icon name={skill.icon} class="h-6 w-6" />
          </div>

          <h3 class="mt-5 text-[17px] font-semibold tracking-tight">{skill.title}</h3>

          <ul class="mt-3 flex flex-wrap gap-1.5">
            {skill.tools.map((tool) => (
              <li class="rounded-md bg-[color:var(--color-bg-soft)] px-2 py-0.5 text-[12px] font-medium text-[color:var(--color-ink-2)]">
                {tool}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
